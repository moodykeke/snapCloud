<link rel="stylesheet" href="/static/style/admin.css">
<script src="/static/js/cloud.js"></script>

<h1><%- locale.get('class_details') %></h1>

<script>
const classId = parseInt(window.location.pathname.split('/').pop());
let classData = null;
let members = [];
let allStudents = []; // 所有可添加的学生

// 加载班级详情
async function loadClassDetails() {
    try {
        const response = await fetch(`/api/v1/classes/${classId}`);
        const data = await response.json();
        
        if (data.success) {
            classData = data.class;
            renderClassInfo();
        } else {
            showError('加载班级信息失败');
        }
    } catch (error) {
        console.error('Error:', error);
        showError('加载班级信息失败');
    }
}

// 加载成员列表
async function loadMembers() {
    try {
        const response = await fetch(`/api/v1/classes/${classId}/members`);
        const data = await response.json();
        
        console.log('Members API response:', data);
        
        if (data.success && Array.isArray(data.members)) {
            members = data.members;
            renderMembers();
        } else if (data.errors) {
            showError(data.errors[0] || '加载成员列表失败');
        } else {
            showError('加载成员列表失败');
        }
    } catch (error) {
        console.error('Error:', error);
        showError('加载成员列表失败: ' + error.message);
    }
}

// 渲染班级信息
function renderClassInfo() {
    if (!classData) return;
    
    document.getElementById('className').textContent = classData.name;
    document.getElementById('classDescription').textContent = classData.description || '<%= locale.get("no_description") %>';
    
    if (classData.stats) {
        document.getElementById('studentCount').textContent = classData.stats.active_student_count || 0;
        document.getElementById('assignmentCount').textContent = classData.stats.published_assignment_count || 0;
    }
}

// 渲染成员列表
function renderMembers() {
    const container = document.getElementById('membersList');
    
    if (members.length === 0) {
        container.innerHTML = `
            <div class="alert alert-info">
                <%= locale.get('no_students_in_class') %>
            </div>
        `;
        return;
    }
    
    container.innerHTML = `
        <table class="table table-hover">
            <thead>
                <tr>
                    <th><%= locale.get('student_username') %></th>
                    <th><%= locale.get('student_email') %></th>
                    <th><%= locale.get('joined_at') %></th>
                    <th><%= locale.get('submitted_assignments') %></th>
                    <th><%= locale.get('average_points') %></th>
                    <th><%= locale.get('status') %></th>
                    <th><%= locale.get('actions') %></th>
                </tr>
            </thead>
            <tbody>
                ${members.map(member => `
                    <tr class="${!member.is_active ? 'table-secondary' : ''}">
                        <td>${escapeHtml(member.student_username)}</td>
                        <td>${escapeHtml(member.student_email || '')}</td>
                        <td>${formatDate(member.joined_at)}</td>
                        <td>${member.submitted_assignment_count || 0}</td>
                        <td>${member.average_points ? member.average_points.toFixed(1) : '-'}</td>
                        <td>
                            ${member.is_active 
                                ? '<span class="badge bg-success"><%= locale.get("active") %></span>'
                                : '<span class="badge bg-secondary"><%= locale.get("inactive") %></span>'}
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" 
                                    onclick="toggleMemberActive(${member.student_id})">
                                <i class="fas fa-toggle-${member.is_active ? 'on' : 'off'}"></i>
                                ${member.is_active ? '<%= locale.get("deactivate") %>' : '<%= locale.get("activate") %>'}
                            </button>
                            <button class="btn btn-sm btn-outline-danger" 
                                    onclick="removeMember(${member.student_id}, '${escapeHtml(member.student_username)}')">
                                <i class="fas fa-times"></i> <%= locale.get('remove') %>
                            </button>
                        </td>
                    </tr>
                `).join('')}
            </tbody>
        </table>
    `;
}

// 显示添加学生对话框
async function showAddStudentDialog() {
    // 加载所有学生
    try {
        const response = await fetch('/api/v1/students');
        const data = await response.json();
        
        console.log('Students API response:', data);
        
        if (data.success && Array.isArray(data.users)) {
            allStudents = data.users;
            renderStudentSelector();
            const modal = new bootstrap.Modal(document.getElementById('addStudentModal'));
            modal.show();
        } else if (data.errors) {
            showError(data.errors[0] || '加载学生列表失败');
        } else {
            showError('加载学生列表失败');
        }
    } catch (error) {
        console.error('Error:', error);
        showError('加载学生列表失败: ' + error.message);
    }
}

// 渲染学生选择器（支持搜索和批量选择）
function renderStudentSelector() {
    const container = document.getElementById('studentListContainer');
    const memberIds = new Set(members.map(m => m.student_id));
    
    const availableStudents = allStudents.filter(s => !memberIds.has(s.id));
    
    if (availableStudents.length === 0) {
        container.innerHTML = '<div class="alert alert-info">没有可添加的学生</div>';
        return;
    }
    
    // 渲染可选学生列表
    container.innerHTML = `
        <div class="mb-3">
            <input type="text" class="form-control" id="studentSearchBox" 
                   placeholder="搜索学生（用户名或邮箱）..." 
                   onkeyup="filterStudents()">
        </div>
        <div class="mb-2">
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="selectAllStudents()">全选</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="deselectAllStudents()">取消全选</button>
            <span class="ms-2 text-muted" id="selectedCount">已选择: 0</span>
        </div>
        <div id="studentList" style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 4px; padding: 10px;">
            ${availableStudents.map(s => `
                <div class="form-check student-item" data-username="${escapeHtml(s.username).toLowerCase()}" 
                     data-email="${escapeHtml(s.email || '').toLowerCase()}">
                    <input class="form-check-input student-checkbox" type="checkbox" 
                           value="${s.id}" id="student_${s.id}" onchange="updateSelectedCount()">
                    <label class="form-check-label" for="student_${s.id}">
                        ${escapeHtml(s.username)} 
                        ${s.email ? `<small class="text-muted">(${escapeHtml(s.email)})</small>` : ''}
                    </label>
                </div>
            `).join('')}
        </div>
    `;
    
    updateSelectedCount();
}

// 搜索过滤学生
function filterStudents() {
    const searchText = document.getElementById('studentSearchBox').value.toLowerCase();
    const studentItems = document.querySelectorAll('.student-item');
    
    studentItems.forEach(item => {
        const username = item.dataset.username;
        const email = item.dataset.email;
        const matches = username.includes(searchText) || email.includes(searchText);
        item.style.display = matches ? 'block' : 'none';
    });
}

// 全选
function selectAllStudents() {
    const visibleCheckboxes = Array.from(document.querySelectorAll('.student-item'))
        .filter(item => item.style.display !== 'none')
        .map(item => item.querySelector('.student-checkbox'));
    
    visibleCheckboxes.forEach(cb => cb.checked = true);
    updateSelectedCount();
}

// 取消全选
function deselectAllStudents() {
    document.querySelectorAll('.student-checkbox').forEach(cb => cb.checked = false);
    updateSelectedCount();
}

// 更新选择计数
function updateSelectedCount() {
    const count = document.querySelectorAll('.student-checkbox:checked').length;
    const countEl = document.getElementById('selectedCount');
    if (countEl) {
        countEl.textContent = `已选择: ${count}`;
    }
}

// 添加学生（批量）
async function addStudent() {
    const checkboxes = document.querySelectorAll('.student-checkbox:checked');
    const studentIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
    
    if (studentIds.length === 0) {
        showError('<%= locale.get("please_select_student") %>');
        return;
    }
    
    try {
        const response = await fetch(`/api/v1/classes/${classId}/members/batch`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_ids: studentIds })
        });
        
        const data = await response.json();
        
        if (data.success) {
            showSuccess(`成功添加 ${studentIds.length} 名学生`);
            const modalEl = document.getElementById('addStudentModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
                modalInstance.hide();
            }
            loadMembers();
            loadClassDetails(); // 更新统计
        } else {
            const errorMsg = data.errors ? data.errors[0] : (data.error || '<%= locale.get("error_add_student") %>');
            showError(errorMsg);
        }
    } catch (error) {
        console.error('Error:', error);
        showError('<%= locale.get("error_add_student") %>: ' + error.message);
    }
}

// 切换学生激活状态
async function toggleMemberActive(studentId) {
    try {
        const response = await fetch(`/api/v1/classes/${classId}/members/${studentId}/toggle`, {
            method: 'POST'
        });
        
        const data = await response.json();
        
        if (data.success) {
            showSuccess('<%= locale.get("status_updated") %>');
            loadMembers();
        } else {
            showError(data.error || '<%= locale.get("error_update_status") %>');
        }
    } catch (error) {
        console.error('Error:', error);
        showError('<%= locale.get("error_update_status") %>');
    }
}

// 移除学生
async function removeMember(studentId, username) {
    if (!confirm(`<%= locale.get("confirm_remove_student") %>`.replace('@1', username))) {
        return;
    }
    
    try {
        const response = await fetch(`/api/v1/classes/${classId}/members/${studentId}`, {
            method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (data.success) {
            showSuccess('<%= locale.get("student_removed") %>');
            loadMembers();
            loadClassDetails(); // 更新统计
        } else {
            showError(data.error || '<%= locale.get("error_remove_student") %>');
        }
    } catch (error) {
        console.error('Error:', error);
        showError('<%= locale.get("error_remove_student") %>');
    }
}

// 工具函数
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function formatDate(dateString) {
    if (!dateString) return '-';
    const date = new Date(dateString);
    return date.toLocaleDateString('zh-CN');
}

function showSuccess(message) {
    alert(message);
}

function showError(message) {
    alert(message);
}

// 页面加载时初始化
document.addEventListener('DOMContentLoaded', function() {
    loadClassDetails();
    loadMembers();
});
</script>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/teacher/classes"><%= locale.get('teacher_classes') %></a></li>
                    <li class="breadcrumb-item active" id="className">...</li>
                </ol>
            </nav>
        </div>
    </div>
    
    <!-- 班级信息卡片 -->
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title" id="className">...</h2>
            <p class="card-text" id="classDescription">...</p>
            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="stat-box">
                        <h3 id="studentCount">0</h3>
                        <p class="text-muted"><%= locale.get('students') %></p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-box">
                        <h3 id="assignmentCount">0</h3>
                        <p class="text-muted"><%= locale.get('assignments') %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- 成员列表 -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><%= locale.get('class_members') %></h5>
            <button class="btn btn-primary btn-sm" onclick="showAddStudentDialog()">
                <i class="fas fa-user-plus"></i> <%= locale.get('add_student') %>
            </button>
        </div>
        <div class="card-body">
            <div id="membersList">
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 添加学生对话框 -->
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= locale.get('add_student') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addStudentForm">
                    <div id="studentListContainer">
                        <div class="text-center">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">加载中...</span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= locale.get('cancel') %></button>
                <button type="button" class="btn btn-primary" onclick="addStudent()">
                    <i class="fas fa-user-plus"></i> <%= locale.get('add') %>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.stat-box {
    text-align: center;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 8px;
}
.stat-box h3 {
    font-size: 2.5rem;
    font-weight: bold;
    color: #007bff;
    margin-bottom: 5px;
}
</style>
