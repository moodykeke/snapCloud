<% if params.username then %>
<%
    -- 判断是否显示所有项目还是仅公开项目
    local is_owner_or_admin = current_user and 
        (current_user.username == params.username or current_user:has_min_role('moderator'))
    local title_key = is_owner_or_admin and 'user_all_projects_title' or 'user_projects_title'
%>
<% content_for('title', locale.get(title_key, params.username)) %>
<h1><%- locale.get(title_key, params.username) %></h1>
<% elseif params.search_term then %>
<% content_for('title', locale.get('project_search_results', params.search_term)) %>
<h1><%- locale.get('project_search_results', params.search_term) %></h1>
<% else %>
<% content_for('title', locale.get('explore')) %>
<h1><%- locale.get('explore') %></h1>
<% end %>
<%
local filters = {}
if current_user and current_user:isadmin() then
  filters = {
            {
                selector = 'bookmarked',
                label = 'Bookmarked',
                options = {
                    { label = 'Any', value = '' },
                    { label = 'Yes', value = true },
                    { label = 'No', value = false },
                }
            },
            {
                selector = 'order_by',
                label = 'Sort by',
                options = {
                    { label = 'Last published', value = 'firstpublished DESC' },
                    { label = 'Created', value = 'created' },
                    { label = 'Last updated', value = 'lastupdated' },
                }
            }
        }
end
render(
    'views.grid',
    {
        class = 'projects',
        item_type = 'project',
        items_per_page = 18,
        items_per_row = 6,
        show_if_empty = true,
        with_search = true,
        filter_descriptors = filters
    }
)
%>
