<%
  local util = require 'lib.util'
  local user_permissions = require 'lib.user_permissions'
  card_classes = (item.role or '') .. ' ' .. (item.verified and '' or 'unverified')
  role_bg_color = ({
    moderator = 'info',
    admin = 'primary',
    banned = 'danger'
})[item.role] or 'secondary' %>

<div class="col-12 col-sm-6 col-md-4 mb-3">
  <div class="card <%- card_classes %>">
      <div class="card-header">
          <% -- 第一行：用户名 昵称 真实姓名 账号类型 %>
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                  <% if not zombie then %>
                  <a class="card-title text-decoration-none" href="<%= item:url_for('site') %>">
                  <% end %>
                      <strong><%- util.visualize_whitespace_html(item.username) %></strong>
                  <% if not zombie then %>
                  </a>
                  <% end %>
                  
                  <span class="text-muted small">
                    <% if item.nickname and item.nickname ~= '' then %>
                      (<%= item.nickname %>)
                    <% else %>
                      (未设置昵称)
                    <% end %>
                  </span>
                  
                  <span class="text-muted small">
                    <% if user_permissions.can_view_real_name(current_user, item) and 
                           item.real_name and item.real_name ~= '' then %>
                        <%= item.real_name %>
                    <% else %>
                        未设置
                    <% end %>
                  </span>
              </div>
              <div class="d-flex gap-1">
                  <% if not item.verified then %>
                  <span class="badge rounded-pill text-bg-warning">unverified</span>
                  <% end %>
                  <% if item.role ~= 'standard' then %>
                  <span class="badge rounded-pill text-bg-<%- role_bg_color %>"><%- item.role %></span>
                  <% end %>
              </div>
          </div>
          
          <% -- 第二行：邮箱 | 创建者（或"个人注册"） %>
          <div class="text-muted small">
              <i class="fas fa-envelope"></i>
              <a href="mailto:<%= item.email %>" class="text-decoration-none"><%= item.email %></a>
              <span class="mx-2">|</span>
              <% if item.creator_id ~= nil then %>
                  <i class="fas fa-user-plus"></i>
                  <%- locale.get('creator') %>: 
                  <a href="/user?user_id=<%= item.creator_id %>"><%= item.creator_id %></a>
              <% else %>
                  <i class="fas fa-user-check"></i>
                  <span><%- locale.get('personal_registration') %></span>
              <% end %>
          </div>
      </div>
      <ul class="list-group list-group-flush">
            <% -- unique_email（如果有） %>
            <% if item.unique_email and item.email ~= item.unique_email then %>
            <li class="list-group-item">
                <span class="badge text-bg-secondary">unique email</span>
                <code><%- util.visualize_whitespace_html(item.unique_email) %></code>
            </li>
            <% end %>
            
            <% -- 用户ID和加入日期（仅在单个用户页面显示） %>
            <% -- 通过检查 queried_user 来判断是否在用户详情页 %>
            <% if queried_user and queried_user.id == item.id then %>
            <li class="list-group-item">
                <% if current_user:has_min_role('moderator') then %>
                <strong><%- locale.get('user_id') %></strong>: <%= item.id %>
                <span class="text-muted mx-2">|</span>
                <% end %>
                <strong><%- locale.get('join_date') %></strong>: <%= string.from_sql_date(item.created) %>
                <% if zombie then %>
                <span class="text-muted mx-2">|</span>
                <strong><%- locale.get('delete_date') %></strong>: <%= string.from_sql_date(item.deleted) %>
                <% end %>
            </li>
            <% end %>
        
        <% -- 项目统计（权限控制） %>
        <% if show_project_count or current_user:has_min_role('moderator') then %>
            <% local project_stats = item:get_project_stats() %>
            <li class="list-group-item" style="min-height: 80px;">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="mb-2">
                            <i class="fas fa-folder text-warning"></i>
                            <strong><%- locale.get('projects') %></strong>
                        </div>
                        <% if project_stats and project_stats.total > 0 then %>
                        <div class="d-flex gap-2 flex-wrap">
                            <% -- 总项目数 %>
                            <a href="/user_projects/<%- item.username %>" 
                               class="badge rounded-pill text-bg-primary text-decoration-none" 
                               title="<%- locale.get('view_all_projects') %>">
                                <i class="fas fa-list"></i> <%- locale.get('total') %>: <%= project_stats.total %>
                            </a>
                            <% if current_user:has_min_role('moderator') or current_user.username == item.username then %>
                            <% -- 分享项目数 %>
                            <a href="/user_projects/<%- item.username %>?filter=shared" 
                               class="badge rounded-pill text-bg-info text-decoration-none"
                               title="<%- locale.get('view_shared_projects') %>">
                                <i class="fas fa-share-alt"></i> <%- locale.get('shared') %>: <%= project_stats.shared %>
                            </a>
                            <% -- 发布项目数 %>
                            <a href="/user_projects/<%- item.username %>?filter=published"
                               class="badge rounded-pill text-bg-success text-decoration-none"
                               title="<%- locale.get('view_published_projects') %>">
                                <i class="fas fa-globe"></i> <%- locale.get('published') %>: <%= project_stats.published %>
                            </a>
                            <% end %>
                        </div>
                        <% else %>
                        <span class="text-muted fst-italic small"><%- locale.get('no_projects') %></span>
                        <% end %>
                    </div>
                    <a href="/user?username=<%- item.username %>" 
                       class="btn btn-sm btn-outline-primary" 
                       title="<%- locale.get('view_user_page') %>">
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </li>
        <% end %>
        
        <% -- 学生统计信息（合并到一行） %>
        <% if item:is_student() and 
               user_permissions.can_view_student_stats(current_user, item) then %>
            <% 
            local classes = item:get_classes()
            local stats = item:get_assignment_stats()
            %>
            
            <li class="list-group-item">
                <div class="row g-2">
                    <% -- 左列：班级信息 %>
                    <div class="col-6">
                        <div class="mb-1">
                            <i class="fas fa-users text-primary"></i>
                            <strong><%- locale.get('classes') %></strong>:
                            <% if classes and #classes > 0 then %>
                            <span class="badge rounded-pill text-bg-info"><%= #classes %></span>
                            <% else %>
                            <span class="text-muted fst-italic small">0</span>
                            <% end %>
                        </div>
                        <% if classes and #classes > 0 then %>
                        <div class="small text-muted">
                            <% for i, class in ipairs(classes) do %>
                                <% if i <= 2 then %>
                                <div class="text-truncate" style="max-width: 100%;">
                                    • <%= class.name %>
                                </div>
                                <% end %>
                            <% end %>
                            <% if #classes > 2 then %>
                            <div class="fst-italic">+ <%= #classes - 2 %> <%- locale.get('more') %></div>
                            <% end %>
                        </div>
                        <% end %>
                    </div>
                    
                    <% -- 右列：作业信息 %>
                    <div class="col-6">
                        <div class="mb-1">
                            <i class="fas fa-tasks text-success"></i>
                            <strong><%- locale.get('assignments') %></strong>:
                            <% if stats and stats.total > 0 then %>
                            <span class="badge rounded-pill text-bg-secondary"><%= stats.total %></span>
                            <% else %>
                            <span class="text-muted fst-italic small">0</span>
                            <% end %>
                        </div>
                        <% if stats and stats.total > 0 then %>
                        <div class="small">
                            <div class="progress mb-1" style="height: 16px;">
                                <div class="progress-bar bg-success" 
                                     role="progressbar" 
                                     style="width: <%= stats.completion_rate %>%">
                                    <%= stats.completion_rate %>%
                                </div>
                            </div>
                            <div class="text-muted">
                                <i class="fas fa-check-circle text-success"></i> <%= stats.submitted %>/<%= stats.total %>
                                <% if stats.avg_points > 0 then %>
                                <br><i class="fas fa-star text-warning"></i> <%= string.format("%.1f", stats.avg_points) %>
                                <% end %>
                            </div>
                        </div>
                        <% end %>
                    </div>
                </div>
            </li>
        <% end %>        <% if not zombie and current_user:has_min_role('moderator') then %>
        <% -- 角色和Teacher显示 - 使用权限函数判断是否可编辑 %>
        <li class="list-group-item">
            <div class="row g-2 align-items-center">
                <% if user_permissions.can_edit_role(current_user, item) then %>
                    <% -- 管理员：可编辑模式 %>
                    <% -- 左侧：角色选择 %>
                    <div class="col-7">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><%- locale.get('role') %></span>
                            <select class="form-select form-select-sm"
                                aria-label="Select a role"
                                onchange="cloud.post(
                                    '/users/<%= item.username %>/set_role',
                                    null,
                                    { username: '<%= item.username %>', role: this.value }
                                );">
                                <% for role, _ in pairs(package.loaded.Users.roles) do %>
                                <option value="<%= role %>"
                                    <%- role == item.role and 'selected' or '' %>
                                >
                                    <%- locale.get(role) %>
                                </option>
                                <% end %>
                            </select>
                        </div>
                    </div>
                    <% -- 右侧：Teacher开关 %>
                    <div class="col-5">
                        <div class="form-check form-switch">
                            <% label_id = "is_teacher-" .. tostring(item.id) %>
                            <input type="checkbox"
                                name="is_teacher"
                                class="form-check-input"
                                id="<%- label_id %>"
                                <%- item.is_teacher and 'checked' or '' %>
                                onchange="
                                    cloud.post(
                                        '/users/<%= item.username %>/set_teacher',
                                        null,
                                        {
                                            username: '<%= item.username %>',
                                            is_teacher: this.checked
                                        }
                                    );"
                            >
                            <label for="<%- label_id %>" class="form-check-label">
                                <%- locale.get('teacher') %>
                            </label>
                        </div>
                    </div>
                <% else %>
                    <% -- 非管理员（版主/教师）：只读模式 %>
                    <div class="col-7">
                        <strong><%- locale.get('role') %></strong>: 
                        <span class="badge rounded-pill text-bg-<%- role_bg_color %>">
                            <%- locale.get(item.role) %>
                        </span>
                    </div>
                    <div class="col-5">
                        <strong><%- locale.get('teacher') %></strong>: 
                        <% if item.is_teacher then %>
                            <i class="fas fa-check-circle text-success"></i>
                            <span class="text-success"><%- locale.get('yes') %></span>
                        <% else %>
                            <i class="fas fa-times-circle text-muted"></i>
                            <span class="text-muted"><%- locale.get('no') %></span>
                        <% end %>
                    </div>
                <% end %>
            </div>
        </li>
        <% end %>
        </ul>
    <div class="card-footer user-profile-actions">
        <% if not zombie then %>
            <% if current_user:has_min_role('admin') then %>
            <div class="btn-group">
                <a class="btn btn-sm btn-outline-secondary become"
                    onclick="cloud.post('/users/<%= item.username %>/become');"
                    ><%- locale.get('become') %></a>
            <% if not item.verified and
                (current_user:has_min_role('moderator')) then %>
                <a class="btn btn-sm btn-outline-success verify"
                    onclick="cloud.post('/users/<%= item.username %>/verify');"
                    ><%- locale.get('verify') %></a>
            <% end %>
            </div>
            <% end %>
            <div class="btn-group" role="group" aria-label="password actions">
                <% if current_user:has_min_role('moderator') or
                        (current_user.is_teacher and
                            item.creator_id == current_user.id) then %>
                <a class="btn btn-sm btn-outline-secondary"
                    onclick="
                        prompt(
                            '<%- locale.get('new_email') %>',
                            email => {
                                cloud.post(
                                    '/users/<%= item.username %>/change_email',
                                    null,
                                    {
                                        email: email,
                                        username: '<%= item.username %>'
                                    }
                                );
                            },
                            nop
                        );
                    "><%- locale.get('change_email') %></a>
                <a class="btn btn-sm btn-outline-secondary"
                    onclick="
                        confirm(
                            '<%= package.loaded.html.escape(locale.get(
                                    'confirm_reset_password',
                                    item.username
                                ))
                            %>',
                            () => {
                                cloud.post(
                                    '/users/<%= item.username %>/password_reset'
                                );
                            }
                        );
                    "><%- locale.get('reset_password') %></a>
                    <a class="btn btn-sm btn-outline-secondary"
                    onclick="
                        prompt(
                            '<%- locale.get('new_username', item.username) %>',
                            username => {
                                cloud.post(
                                    '/users/<%= item.username %>/change_username',
                                    null,
                                    {
                                        new_username: username
                                    }
                                );
                            },
                            nop
                        );
                    "><%- locale.get('change_username') %></a>
                <% end %>
        </div>
        <% end %>
        <% if current_user:has_min_role('moderator') then %>
        <div class="btn-group">
            <a class="btn btn-sm btn-outline-info"
                onclick="
                    dialog(
                        '<%- locale.get('compose_email') %>',
                        '<%= package.loaded.dialog('compose_email') %>',
                        () => {
                            var form =
                                document.querySelector('form.email-compose'),
                                subject = form.querySelector('input').value,
                                contents = form.querySelector('textarea').value;
                            cloud.post(
                                '/users/<%= item.username %>/send_email',
                                null,
                                {
                                    subject: subject,
                                    contents: contents
                                }
                            );
                        },
                        nop
                    );
                "><%- locale.get('send_msg') %></a>
            </div>
            <div class="btn-group" role="group" aria-label="unsafe actions">
                <% if not zombie then %>
                <a class="btn btn-sm ban btn-outline-danger"
                    onclick="
                        cloud.post(
                            '/users/<%= item.username %>/set_role',
                            null,
                            {
                                username: '<%= item.username %>',
                                role: <%-
                                    item.role == 'banned'
                                        and "'standard'"
                                        or "'banned'" %>
                            }
                        );"
                    ><%= item.role == 'banned' and
                        locale.get('unban') or
                        locale.get('ban') %></a>
                <% end %>
                <a class="btn btn-sm delete btn-outline-danger"
                    onclick="
                        confirm(
                            '<%=
                                package.loaded.dialog(
                                    'delete_user',
                                    { username = item.username })
                            %>',
                            () => {
                                cloud.delete(
                                    '/<%= zombie and 'zombies' or 'users' %>/<%= item.username %>'
                                );
                            }
                        );
                    "
                    ><%-
                        locale.get(zombie and 'perma_delete_usr' or 'delete_usr')
                    %></a>
                <% if zombie then %>
                <a class="btn btn-sm btn-outline-secondary"
                    onclick="
                        confirm(
                            '<%= locale.get('confirm_revive', item.username) %>',
                            () => {
                                cloud.post('/zombies/<%= item.username %>/revive');
                            }
                        );
                    "
                    ><%- locale.get('revive_usr') %></a>
                <% end %>
            </div>
        <% end %>
        </div>
    </div>
</div>
