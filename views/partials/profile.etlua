<%
  local util = require 'lib.util'
  local user_permissions = require 'lib.user_permissions'
  card_classes = (item.role or '') .. ' ' .. (item.verified and '' or 'unverified')
  role_bg_color = ({
    moderator = 'info',
    admin = 'primary',
    banned = 'danger'
})[item.role] or 'secondary' %>

<div class="col-12 col-sm-6 col-md-4 mb-3">
  <div class="card <%- card_classes %>">
      <div class="card-header">
          <% -- 第一行：用户名 昵称 真实姓名 账号类型 %>
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                  <% if not zombie then %>
                  <a class="card-title text-decoration-none" href="<%= item:url_for('site') %>">
                  <% end %>
                      <strong><%- util.visualize_whitespace_html(item.username) %></strong>
                  <% if not zombie then %>
                  </a>
                  <% end %>
                  
                  <% if item.nickname and item.nickname ~= '' then %>
                  <span class="text-muted small">(<%= item.nickname %>)</span>
                  <% end %>
                  
                  <% if user_permissions.can_view_real_name(current_user, item) then %>
                      <% if item.real_name and item.real_name ~= '' then %>
                      <span class="text-muted small"><%= item.real_name %></span>
                      <% end %>
                  <% end %>
              </div>
              <div class="d-flex gap-1">
                  <% if not item.verified then %>
                  <span class="badge rounded-pill text-bg-warning">unverified</span>
                  <% end %>
                  <% if item.role ~= 'standard' then %>
                  <span class="badge rounded-pill text-bg-<%- role_bg_color %>"><%- item.role %></span>
                  <% end %>
              </div>
          </div>
          
          <% -- 第二行：邮箱 | 创建者（或"个人注册"） %>
          <div class="text-muted small d-flex align-items-center flex-wrap gap-1">
              <% if user_permissions.can_view_email(current_user, item) then %>
              <span class="d-inline-flex align-items-center gap-1">
                  <i class="fas fa-envelope"></i>
                  <a href="mailto:<%= item.email %>" class="text-decoration-none text-nowrap"><%= item.email %></a>
              </span>
              <% if item.creator_id ~= nil or current_user:has_min_role('moderator') then %>
              <span class="text-muted">|</span>
              <% end %>
              <% end %>
              <% if item.creator_id ~= nil then %>
              <span class="d-inline-flex align-items-center gap-1">
                  <i class="fas fa-user-plus"></i>
                  <span><%- locale.get('creator') %>: <a href="/user?user_id=<%= item.creator_id %>"><%= item.creator_id %></a></span>
              </span>
              <% elseif current_user:has_min_role('moderator') then %>
              <span class="d-inline-flex align-items-center gap-1">
                  <i class="fas fa-user-check"></i>
                  <span><%- locale.get('personal_registration') %></span>
              </span>
              <% end %>
          </div>
      </div>
      <ul class="list-group list-group-flush">
            <% -- unique_email（如果有） %>
            <% if item.unique_email and item.email ~= item.unique_email then %>
            <li class="list-group-item">
                <span class="badge text-bg-secondary">unique email</span>
                <code><%- util.visualize_whitespace_html(item.unique_email) %></code>
            </li>
            <% end %>
            
            <% -- 用户ID和加入日期（仅在单个用户页面显示） %>
            <% -- 通过检查 queried_user 来判断是否在用户详情页 %>
            <% if queried_user and queried_user.id == item.id then %>
            <li class="list-group-item">
                <% if current_user:has_min_role('moderator') then %>
                <strong><%- locale.get('user_id') %></strong>: <%= item.id %>
                <span class="text-muted mx-2">|</span>
                <% end %>
                <strong><%- locale.get('join_date') %></strong>: <%= string.from_sql_date(item.created) %>
                <% if zombie then %>
                <span class="text-muted mx-2">|</span>
                <strong><%- locale.get('delete_date') %></strong>: <%= string.from_sql_date(item.deleted) %>
                <% end %>
            </li>
            <% end %>
        
        <% -- 项目统计（权限控制） - 紧凑显示 %>
        <% if show_project_count or current_user:has_min_role('moderator') then %>
            <% local project_stats = item:get_project_stats() %>
            <li class="list-group-item">
                <i class="fas fa-folder text-muted"></i>
                <strong class="ms-1"><%- locale.get('projects') %></strong>:
                <% if project_stats and project_stats.total > 0 then %>
                    <a href="/user_projects/<%- item.username %>" 
                       class="text-decoration-none ms-1"
                       title="<%- locale.get('view_all_projects') %>">
                        <span class="badge text-bg-secondary"><%= project_stats.total %></span>
                    </a>
                    <% -- 分享和发布统计始终显示（如果大于0） %>
                    <% if project_stats.shared > 0 then %>
                    <span class="text-muted mx-1">|</span>
                    <a href="/user_projects/<%- item.username %>?filter=shared" 
                       class="text-decoration-none"
                       title="<%- locale.get('view_shared_projects') %>">
                        <i class="fas fa-share-alt text-info"></i>
                        <span class="small"><%= project_stats.shared %></span>
                    </a>
                    <% end %>
                    <% if project_stats.published > 0 then %>
                    <span class="text-muted mx-1">|</span>
                    <a href="/user_projects/<%- item.username %>?filter=published"
                       class="text-decoration-none"
                       title="<%- locale.get('view_published_projects') %>">
                        <i class="fas fa-globe text-success"></i>
                        <span class="small"><%= project_stats.published %></span>
                    </a>
                    <% end %>
                <% else %>
                    <span class="text-muted small ms-1">0</span>
                <% end %>
            </li>
        <% end %>
        
                <% -- 学生统计（班级 + 作业统计） - 紧凑显示 %>
        <% if current_user:has_min_role('moderator') and can_view_student_stats then %>
            <% local classes = item:get_student_classes() %>
            <% local stats = item:get_assignment_stats() %>
            <li class="list-group-item">
                <% -- 班级信息 %>
                <div class="mb-2">
                    <i class="fas fa-users text-muted"></i>
                    <strong class="ms-1"><%- locale.get('classes') %></strong>:
                    <% if classes and #classes > 0 then %>
                        <span class="badge text-bg-secondary"><%= #classes %></span>
                        <span class="small text-muted ms-1">
                        <% for i, class in ipairs(classes) do %>
                            <%= i > 1 and ', ' or '' %><%= class.name %>
                        <% end %>
                        </span>
                    <% else %>
                        <span class="text-muted small ms-1">-</span>
                    <% end %>
                </div>
                
                <% -- 作业统计 %>
                <div>
                    <i class="fas fa-tasks text-muted"></i>
                    <strong class="ms-1"><%- locale.get('assignments') %></strong>:
                    <% if stats and stats.total > 0 then %>
                        <span class="badge text-bg-secondary"><%= stats.total %></span>
                        <span class="small text-muted ms-1">
                            <i class="fas fa-check-circle text-success"></i> <%= stats.submitted %>
                            <% if stats.avg_points > 0 then %>
                            | <i class="fas fa-star text-muted"></i> <%= string.format("%.1f", stats.avg_points) %>
                            <% end %>
                            (<%= stats.completion_rate %>%)
                        </span>
                    <% else %>
                        <span class="text-muted small ms-1">-</span>
                    <% end %>
                </div>
            </li>
        <% end %>        <% if not zombie and current_user:has_min_role('moderator') then %>
        <% -- 角色和Teacher显示 - 使用权限函数判断是否可编辑 %>
        <li class="list-group-item">
            <div class="row g-2 align-items-center">
                <% if user_permissions.can_edit_role(current_user, item) then %>
                    <% -- 管理员：可编辑模式 %>
                    <% -- 左侧：角色选择 %>
                    <div class="col-7">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><%- locale.get('role') %></span>
                            <select class="form-select form-select-sm"
                                aria-label="Select a role"
                                onchange="cloud.post(
                                    '/users/<%= item.username %>/set_role',
                                    null,
                                    { username: '<%= item.username %>', role: this.value }
                                );">
                                <% for role, _ in pairs(package.loaded.Users.roles) do %>
                                <option value="<%= role %>"
                                    <%- role == item.role and 'selected' or '' %>
                                >
                                    <%- locale.get(role) %>
                                </option>
                                <% end %>
                            </select>
                        </div>
                    </div>
                    <% -- 右侧：Teacher开关 %>
                    <div class="col-5">
                        <div class="form-check form-switch">
                            <% label_id = "is_teacher-" .. tostring(item.id) %>
                            <input type="checkbox"
                                name="is_teacher"
                                class="form-check-input"
                                id="<%- label_id %>"
                                <%- item.is_teacher and 'checked' or '' %>
                                onchange="
                                    cloud.post(
                                        '/users/<%= item.username %>/set_teacher',
                                        null,
                                        {
                                            username: '<%= item.username %>',
                                            is_teacher: this.checked
                                        }
                                    );"
                            >
                            <label for="<%- label_id %>" class="form-check-label">
                                <%- locale.get('teacher') %>
                            </label>
                        </div>
                    </div>
                <% else %>
                    <% -- 非管理员（版主/教师）：只读模式 %>
                    <div class="col-7">
                        <strong><%- locale.get('role') %></strong>: 
                        <span class="badge rounded-pill text-bg-<%- role_bg_color %>">
                            <%- locale.get(item.role) %>
                        </span>
                    </div>
                    <div class="col-5">
                        <strong><%- locale.get('teacher') %></strong>: 
                        <% if item.is_teacher then %>
                            <i class="fas fa-check-circle text-success"></i>
                            <span class="text-success"><%- locale.get('yes') %></span>
                        <% else %>
                            <i class="fas fa-times-circle text-muted"></i>
                            <span class="text-muted"><%- locale.get('no') %></span>
                        <% end %>
                    </div>
                <% end %>
            </div>
        </li>
        <% end %>
        </ul>
    <div class="card-footer user-profile-actions">
        <% if not zombie then %>
            <% -- 主要操作按钮 %>
            <div class="btn-group mb-2" role="group">
                <% if current_user:has_min_role('admin') then %>
                <a class="btn btn-sm btn-outline-secondary"
                    onclick="cloud.post('/users/<%= item.username %>/become');">
                    <i class="fas fa-user-secret"></i> <%- locale.get('become') %>
                </a>
                <% end %>
                <% if current_user:has_min_role('moderator') then %>
                <a class="btn btn-sm btn-outline-info"
                    onclick="
                        dialog(
                            '<%- locale.get('compose_email') %>',
                            '<%= package.loaded.dialog('compose_email') %>',
                            () => {
                                var form = document.querySelector('form.email-compose'),
                                    subject = form.querySelector('input').value,
                                    contents = form.querySelector('textarea').value;
                                cloud.post(
                                    '/users/<%= item.username %>/send_email',
                                    null,
                                    { subject: subject, contents: contents }
                                );
                            },
                            nop
                        );
                    ">
                    <i class="fas fa-envelope"></i> <%- locale.get('send_msg') %>
                </a>
                <% end %>
                
                <% -- 账户操作下拉菜单 %>
                <% if current_user:has_min_role('moderator') or
                        (current_user.is_teacher and item.creator_id == current_user.id) then %>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-cog"></i> <%- locale.get('account_settings') %>
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="#"
                                onclick="
                                    prompt(
                                        '<%- locale.get('new_email') %>',
                                        email => {
                                            cloud.post(
                                                '/users/<%= item.username %>/change_email',
                                                null,
                                                { email: email, username: '<%= item.username %>' }
                                            );
                                        },
                                        nop
                                    );
                                    return false;
                                ">
                                <i class="fas fa-envelope"></i> <%- locale.get('change_email') %>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#"
                                onclick="
                                    confirm(
                                        '<%= package.loaded.html.escape(locale.get(
                                                'confirm_reset_password',
                                                item.username
                                            ))
                                        %>',
                                        () => {
                                            cloud.post('/users/<%= item.username %>/password_reset');
                                        }
                                    );
                                    return false;
                                ">
                                <i class="fas fa-key"></i> <%- locale.get('reset_password') %>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#"
                                onclick="
                                    prompt(
                                        '<%- locale.get('new_username', item.username) %>',
                                        username => {
                                            cloud.post(
                                                '/users/<%= item.username %>/change_username',
                                                null,
                                                { new_username: username }
                                            );
                                        },
                                        nop
                                    );
                                    return false;
                                ">
                                <i class="fas fa-user-edit"></i> <%- locale.get('change_username') %>
                            </a>
                        </li>
                        <% if not item.verified and current_user:has_min_role('moderator') then %>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-success" href="#"
                                onclick="cloud.post('/users/<%= item.username %>/verify'); return false;">
                                <i class="fas fa-check-circle"></i> <%- locale.get('verify') %>
                            </a>
                        </li>
                        <% end %>
                    </ul>
                </div>
                <% end %>
            </div>
            
            <% -- 危险操作按钮 %>
            <% if current_user:has_min_role('moderator') then %>
            <div class="btn-group mb-2" role="group" aria-label="unsafe actions">
                <a class="btn btn-sm btn-outline-danger"
                    onclick="
                        cloud.post(
                            '/users/<%= item.username %>/set_role',
                            null,
                            {
                                username: '<%= item.username %>',
                                role: <%-
                                    item.role == 'banned'
                                        and "'standard'"
                                        or "'banned'" %>
                            }
                        );">
                    <i class="fas fa-ban"></i>
                    <%= item.role == 'banned' and locale.get('unban') or locale.get('ban') %>
                </a>
                <a class="btn btn-sm btn-outline-danger"
                    onclick="
                        confirm(
                            '<%=
                                package.loaded.dialog(
                                    'delete_user',
                                    { username = item.username })
                            %>',
                            () => {
                                cloud.delete('/users/<%= item.username %>');
                            }
                        );
                    ">
                    <i class="fas fa-trash"></i> <%- locale.get('delete_usr') %>
                </a>
            </div>
            <% end %>
        <% else %>
            <% -- Zombie 用户操作 %>
            <% if current_user:has_min_role('moderator') then %>
            <div class="btn-group mb-2" role="group">
                <a class="btn btn-sm btn-outline-secondary"
                    onclick="
                        confirm(
                            '<%= locale.get('confirm_revive', item.username) %>',
                            () => {
                                cloud.post('/zombies/<%= item.username %>/revive');
                            }
                        );
                    ">
                    <i class="fas fa-heart"></i> <%- locale.get('revive_usr') %>
                </a>
                <a class="btn btn-sm btn-outline-danger"
                    onclick="
                        confirm(
                            '<%=
                                package.loaded.dialog(
                                    'delete_user',
                                    { username = item.username })
                            %>',
                            () => {
                                cloud.delete('/zombies/<%= item.username %>');
                            }
                        );
                    ">
                    <i class="fas fa-trash"></i> <%- locale.get('perma_delete_usr') %>
                </a>
            </div>
            <% end %>
        <% end %>
    </div>
</div>
