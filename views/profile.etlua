<% content_for('title', locale.get('profile_title', user.username)) %>
<h1 class="my-2"><%- locale.get('profile_title', user.username) %></h1>

<div class="row my-4">
    <div class="col-md-6">
        <div class="mb-2">
            <strong><%- locale.get('join_date') %> </strong>
            <span class="created"><%= string.from_sql_date(user.created) %></span>
        </div>
        <div class="mb-2">
            <strong>真实姓名: </strong>
            <span id="realname-display"><%= user.real_name or '未设置' %></span>
            <% if user.is_teacher or user:isadmin() then %>
            <button class="btn btn-sm btn-outline-primary ms-2" onclick="editRealName()">
                <i class="fas fa-edit"></i> 编辑
            </button>
            <% else %>
            <small class="text-muted">(仅教师可修改)</small>
            <% end %>
        </div>
        <div class="mb-2">
            <strong>昵称: </strong>
            <span id="nickname-display"><%= user.nickname or '未设置' %></span>
            <button class="btn btn-sm btn-outline-primary ms-2" onclick="editNickname()">
                <i class="fas fa-edit"></i> 编辑
            </button>
        </div>
        <div class="mb-2">
            <strong><%- locale.get('email') %> </strong>
            <span class="email">
                <a href="mailto:<%= user.email %>" target="_blank"><%= user.email %></a>
            </span>
        </div>
        <% if user.role ~= 'standard' then %>
        <div class="mb-2">
            <span class="role-container">
                <strong><%- locale.get('role') %></strong><strong> </strong>
                <span class="role"><%- locale.get(user.role) %></span>
            </span>
        </div>
        <% end %>
    </div>
    <div class="col-md-6">
        <div class="mb-2">
            <a class="btn btn-secondary my-1"
                href="change_password"><%- locale.get('change_my_password') %></a>
            <% if not user:is_student() then %>
            <a class="btn btn-secondary my-1"
                href="change_email"><%- locale.get('change_my_email') %></a>
            <% end %>
            <a class="btn btn-danger my-1" onclick="
                confirmDeleteMyself()"><%- locale.get('delete_my_user') %></a>
        </div>
    </div>
</div>

<% if user:is_student() then %>
<div class="row my-4">
    <div class="col-12">
        <h2>Student Info</h2>
        This is a <em>learner</em> account. Someone else has the ability to login to your account, view your projects, and change your password.
        <br>
        We encourage you to <a href="/join" target="_blank">sign up  for your own account.</a>
    </div>
</div>
<% end %>

<script>
    function editRealName() {
        const currentRealName = '<%= user.real_name or "" %>';
        prompt(
            '请输入您的真实姓名（仅教师和管理员可见）',
            (newRealName) => {
                if (newRealName !== null && newRealName.trim() !== '') {
                    saveRealName(newRealName.trim());
                }
            }
        );
        // 设置输入框的默认值
        setTimeout(() => {
            const input = document.querySelector('#customconfirm input, #customalert input');
            if (input) {
                input.value = currentRealName;
            }
        }, 100);
    }
    
    async function saveRealName(realName) {
        try {
            const response = await fetch('/api/v1/users/current/realname', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ real_name: realName })
            });
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('realname-display').textContent = realName;
                alert('真实姓名已更新');
            } else {
                alert('更新失败: ' + (data.error || '未知错误'));
            }
        } catch (error) {
            console.error('Error:', error);
            alert('更新失败: ' + error.message);
        }
    }
    
    function editNickname() {
        const currentNickname = '<%= user.nickname or "" %>';
        prompt(
            '请输入您的昵称（方便教师识别）',
            (newNickname) => {
                if (newNickname !== null && newNickname.trim() !== '') {
                    saveNickname(newNickname.trim());
                }
            }
        );
        // 设置输入框的默认值
        setTimeout(() => {
            const input = document.querySelector('#customconfirm input, #customalert input');
            if (input) {
                input.value = currentNickname;
            }
        }, 100);
    }
    
    async function saveNickname(nickname) {
        try {
            const response = await fetch('/api/v1/users/current/nickname', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ nickname: nickname })
            });
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('nickname-display').textContent = nickname;
                alert('昵称已更新');
            } else {
                alert('更新失败: ' + (data.error || '未知错误'));
            }
        } catch (error) {
            console.error('Error:', error);
            alert('更新失败: ' + error.message);
        }
    }
    
    function confirmDeleteMyself () {
        confirm(
            '<%= locale.get('confirm_delete_usr', user.username) %><br>' +
            '<i class="warning fa fa-exclamation-triangle"></i> ' +
            '<%- locale.get('warning_no_return') %>' +
            ' <i class="warning fa fa-exclamation-triangle"></i>',
            () => { location.href = 'delete_user' },
            confirmTitle('<%- locale.get('delete_my_user') %>')
        );
    };
</script>
